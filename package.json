{
  "name": "new-york-election-results",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e",
    "data:prepare": "python3 scripts/prepare-data.py",
    "issues:seed": "node scripts/seed-issues.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "d3": "7.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/d3": "7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.0",
    "typescript": "5.7.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
